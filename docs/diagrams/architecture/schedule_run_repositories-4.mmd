flowchart TD
    Due["Due active schedule"] --> Dispatch["Dispatch schedule fire"]
    Dispatch --> Header["Create running schedule-run header"]
    Dispatch --> Leaves["Create device execution leaves"]
    Leaves --> Results["Receive device results"]
