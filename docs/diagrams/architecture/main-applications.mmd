    Auth --> Mongo
    Management --> Mongo
    Api --> Nats["NATS"]
    Client --> Nats
    Management --> Nats
    Client --> Kafka["Kafka"]
    Stream --> Kafka
    Stream --> Cassandra[("Cassandra")]
    Stream --> Pinot[("Pinot")]
