    MapCreds --> MapApiKey["toToolApiKeyResponse()"]
    MapApiKey --> ApiKeyResponse["ToolApiKeyResponse"]
    
    UrlResponse --> Assemble["Assemble ToolResponse"]
    ApiKeyResponse --> Assemble
    
    Assemble --> FinalResponse["ToolResponse<br/>(REST DTO)"]