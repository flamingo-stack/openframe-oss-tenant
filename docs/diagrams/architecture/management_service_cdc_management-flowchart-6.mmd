    style KafkaLayer fill:#f3e5f5,stroke:#4a148c,stroke-width:2px
    style ProcessingLayer fill:#e1f5ff,stroke:#01579b,stroke-width:2px
    style ManagementLayer fill:#fce4ec,stroke:#880e4f,stroke-width:2px