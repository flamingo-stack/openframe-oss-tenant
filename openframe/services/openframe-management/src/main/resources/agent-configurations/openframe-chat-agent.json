{
  "id": "openframe-chat",
  "version": "0.1.0",
  "status": "ENABLED",
  "sessionType": "USER",
  "runCommandArgs": [
    "--serverUrl", "${client.serverUrl}",
    "--openframe-secret", "${client.openframeSecret}",
    "--openframe-token-path", "${client.openframeTokenPath}"
  ],
  "agentToolIdCommandArgs": [],
  "downloadConfigurations": [
    {
      "os": "windows",
      "linkTemplate": "https://github.com/openframe/openframe-chat/releases/download/v{version}/openframe-chat-windows-{version}.exe",
      "fileName": "openframe-chat-windows-{version}.exe"
    },
    {
      "os": "macos",
      "linkTemplate": "https://github.com/openframe/openframe-chat/releases/download/v{version}/openframe-chat-macos-{version}.dmg",
      "fileName": "openframe-chat-macos-{version}.dmg"
    }
  ]
}

