{
  "id": "meshcentral-agent",
  "toolId": "meshcentral-server",
  "version": "1.0.0",
  "status": "ENABLED",
  "sessionType": "CONSOLE",
  "runCommandArgs": [
    "connect",
    "--openframe-mode",
    "--openframe-secret", "${client.openframeSecret}",
    "--openframe-token-path", "${client.openframeTokenPath}"
  ],
  "agentToolIdCommandArgs": [
    "-nodeid-base64"
  ],
  "downloadConfigurations": [
    {
      "os": "windows",
      "linkTemplate": "https://github.com/Ylianst/MeshAgent/releases/download/v{version}/meshagent-windows-{version}.exe",
      "fileName": "meshagent-windows-{version}.exe"
    },
    {
      "os": "macos",
      "linkTemplate": "https://github.com/Ylianst/MeshAgent/releases/download/v{version}/meshagent-macos-{version}",
      "fileName": "meshagent-macos-{version}"
    }
  ],
  "assets": [
    {
      "id": "meshcentral-core-module",
      "localFilename": "CoreModule.js",
      "source": "ARTIFACTORY",
      "executable": false
    },
    {
      "id": "msh-configuration",
      "localFilename": "agent.msh",
      "source": "TOOL_API",
      "path": "/generate-msh?host=${client.serverUrl}",
      "executable": false
    }
  ]
}
