      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 7,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 * redis_memory_used_bytes{namespace=\"datasources\"} / redis_memory_max_bytes{namespace=\"datasources\"}",
