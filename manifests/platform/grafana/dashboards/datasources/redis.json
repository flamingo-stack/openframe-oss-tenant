        {
          "expr": "redis_memory_rss_bytes{namespace=\"datasources\"}",
          "legendFormat": "RSS",
          "refId": "C"
        }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
